{
    "manifest_version": 2.0,
    "id": "bicqa",
    "name": "BIC-QA 智能分析",
    "version": "1.0.0",
    "namespace": "Bicqa",
    "author": "WorkBuddy",
    "url": "https://api.bic-qa.com/bic-qa-html/apikey-guide.zhcn.html",
    "description": "把 BIC-QA 数据库知识库嵌入 Zabbix 告警现场：对话问答、告警根因分析、Problems 页一键 AI 分析。",
    "actions": {
        "bicqa.main": {
            "class": "Main",
            "view": "bicqa.main",
            "layout": "layout.htmlpage"
        },
        "bicqa.proxy": {
            "class": "Proxy",
            "layout": "layout.json"
        },
        "bicqa.config.save": {
            "class": "ConfigSave",
            "layout": "layout.json"
        }
    },
    "assets": {
        "css": ["bicqa.css"],
        "js": []
    }
}
